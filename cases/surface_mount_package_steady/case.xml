<?xml version="1.0" encoding="UTF-8"?>
<case name="surface_mount_package">
  <paths mesh="mesh.mphtxt" mesh_unit="mm" materials="material.xml" comsol_result="result.txt" />

  <study type="steady" />

  <variables>
    <var name="T_amb" value="303.15[K]" />
    <var name="T_bc" value="323.15[K]" />
    <var name="h_conv" value="50[W/m^2/K]" />
    <var name="Q_chip" value="2e8[W/m^3]" />
  </variables>

  <!-- Domain-to-material mapping:
       mat1 (Aluminum, k=238): domain 1 only (lead frame)
       mat2 (FR4, k=0.3): domain 2 (circuit board)
       mat3 (Plastic, k=0.2): domains 4, 5-10, 12-15
       mat4 (Silicon, k=130): domain 11 (chip)
       mat5 (Copper, k=400): domains 16-19 (solder pads)
  -->
  <materials>
    <assign domains="3-10,12-19" material="mat1" />
    <assign domains="1" material="mat2" />
    <assign domains="2" material="mat3" />
    <assign domains="11" material="mat4" />
    <assign boundaries="7, 37" material="mat5" />
  </materials>

  <physics kind="heat_transfer" order="2">
    <SolverConfiguration>
      <LinearSolver type="CG">
        <Parameters>
          <Tolerance>1e-10</Tolerance>
          <MaxIterations>1000</MaxIterations>
          <PrintLevel>0</PrintLevel>
        </Parameters>
        <Preconditioner type="Diagonal"/>
      </LinearSolver>
    </SolverConfiguration>
    <boundary kind="convection" ids="1-3, 5-20, 22-34, 38, 40-51, 53-68, 70-82, 84, 86-97, 99-114, 116-128, 130, 132-143, 145-160, 162-174, 176, 178-189, 191, 192, 198-211, 213-225, 227, 229-240, 242, 243, 245-258, 260-272, 274, 276-287, 289-304, 306-318, 320, 322-333, 335-350, 352-364, 366, 368-379, 381-398">
      <param name="h" value="h_conv"/>
      <param name="T_inf" value="T_amb"/>
    </boundary>
    <boundary kind="temperature" ids="4">
      <param name="value" value="T_bc"/>
    </boundary>
    <boundary kind="thin_layer" ids="7">
      <param name="thickness" value="1e-4[m]"/>
      <param name="conductivity" value="400[W/(m*K)]"/>
    </boundary>
    <boundary kind="thin_layer" ids="37">
      <param name="thickness" value="5e-6[m]"/>
      <param name="conductivity" value="400[W/(m*K)]"/>
    </boundary>
    <source kind="volumetric_heat_source" domains="11" value="Q_chip" />
  </physics>

  <coupling method="picard" max_iter="1" tolerance="1e-6"/>
</case>